# Copy to an env file and fill in the values. Never commit a real .env.
# The installer writes /etc/tanveer-discord-bot/bot.env for you (mode 640, root:tanveer-bot).

# Required: bot token from the Discord developer portal (Bot > Reset Token). Keep it secret.
DISCORD_TOKEN=
# Required: application (client) ID from the Discord developer portal.
DISCORD_CLIENT_ID=
# Optional: a test server ID for instant command registration during development.
DISCORD_DEV_GUILD_ID=

# Global owners, comma-separated verified numeric Discord user IDs. Defaults to the owner from the brief.
# Only numeric IDs are accepted. Usernames, display names and server permissions never grant ownership.
OWNER_IDS=1131248987173814336

# Storage. Relative paths are resolved from the working directory.
DATABASE_PATH=./data/bot.sqlite
BACKUP_DIR=./data/backups

# Runtime behaviour.
NODE_ENV=production
LOG_LEVEL=info
LOG_FORMAT=json
COMMAND_COOLDOWN_MS=1500
SCHEDULER_INTERVAL_MS=15000
